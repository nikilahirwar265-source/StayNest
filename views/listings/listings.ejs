<% layout('../layouts/boilerplate.ejs') %>

    <body>
        <!-- flash for review -->
        <% if (review && review.length> 0) { %>
            <div class="alert alert-info alert-dismissible " role="alert">
                <%= review %> <button type="button" class="btn-close" data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
            <% } %>

                <!-- listings data -->
                <div class="lisings-container">
                    <ul>
                        <% for(data of aboutData){%>
                            <div class="data-items">

                                <h4>
                                    <%= data.title %>
                                </h4>

                            </div>
                            <div class="data-items"><img src="<%= data.image.url %>" alt="<%= data.title %>"
                                    id="listing-img">
                            </div>

                            <div class="data-items">
                                <h4>Entire apartment in <%= data.location %> ,
                                        <%= data.country %>
                                </h4>

                                <p>&#8377; <%= data.price.toLocaleString("en-IN") %> for 2 nights
                                </p>

                            </div>


                            <% if(owner===currentUser.id){ %>
                                <div class="form-btn data-items">
                                    <form action="/listing/update/<%= data.id %>"><button class="edit-btn">edit</button>
                                    </form>

                                    <form action="/listing/delete/<%= data.id %>"><button
                                            class="delete-btn">delete</button>
                                    </form>
                                </div>
                                <% } %>

                                    <% } %>
                    </ul>
                </div>
                <hr>

                <!-- Review data -->
                <div class="Review-container">

                    <form method="post" action="/review/<%= data.id %>" class="needs-validation" novalidate>
                        <h3>Add the reviews </h3>
                        <fieldset class="starability-basic">
                            <legend> rating:</legend>
                            <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked
                                aria-label="No rating." min="1" max="5" />

                            <input type="radio" id="rate1" name="rating" value="1" />
                            <label for="rate1">1 star.</label>

                            <input type="radio" id="rate2" name="rating" value="2" />
                            <label for="rate2">2 stars.</label>

                            <input type="radio" id="rate3" name="rating" value="3" />
                            <label for="rate3">3 stars.</label>

                            <input type="radio" id="rate4" name="rating" value="4" />
                            <label for="rate4">4 stars.</label>

                            <input type="radio" id="rate5" name="rating" value="5" />
                            <label for="rate5">5 stars.</label>

                            <span class="starability-focus-ring"></span>
                        </fieldset>

                        <div class="mb-4">
                            <label for="exampleFormControlTextarea2" class="form-label"><b>comment:</b></label>
                            <textarea class="form-control textarea" id="exampleFormControlTextarea2" rows="5" cols="10"
                                name="comment" required></textarea>
                            <div class="valid-feedback">
                                Looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please add Review
                            </div>

                        </div>

                        <button class="btn btn-primary ">Add Review</button>
                    </form>
                </div>
                <hr>

                <% if (reviews.length> 0) { %>
                    <h4>All the Reviews</h4>
                    <div class="review-container">
                        <% for(review of reviews) {%>
                            <div class="card">
                                <div class="card-body">
                                    <h5>
                                        <%= review.reviewOwner.email %>
                                    </h5>
                                    <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                    </p>
                                    <p class="card-text"> <b>Comment:</b>
                                        <%= review.comment %>
                                    </p>

                                    <% if(review && review.reviewOwner.id===currentUser.id){ %>
                                        <form method="post"
                                            action="/review/<%= review.id %>/listings/<%= data.id %>/?_method=DELETE">
                                            <button class="btn btn-primary review-btn-delete">Delete Review</button>
                                        </form>
                                        <% } %>

                                </div>
                            </div>


                            <%} %>
                    </div>
                    <% } %>

                        <script>
                            const place = "<%= data.location %>";
                            // global variable
                            window.place = place;
                        </script>
                        <!-- show map -->
                        <div class="map">

                            >
                            <h4>Where you’ll be</h4>
                            <h5>Entire apartment in <%= data.location %> ,
                                    <%= data.country %>
                            </h5>

                            <div id="map"> </div>
                        </div>

                        <!-- Leaflet JS -->
                        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
                        <script src="/js/map.js"></script>

                        <script src="/js/validationForm.js"></script>
    </body>