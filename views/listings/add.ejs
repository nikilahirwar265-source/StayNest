<% layout('../layouts/boilerplate.ejs') %>

    <body>
        <div class="form-container">
            <form method="post" action="/listing/add/list" class="needs-validation" novalidate
                enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="exampleFormControlInput1" class="form-label">Title:</label>
                    <input type="text" class="form-control" id="exampleFormControlInput1" name="title"
                        placeholder="Enter the title" required>
                    <div class="invalid-feedback">
                        Please Enter the Title.</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>

                <div class="mb-3">
                    <label for="exampleFormControlTextarea2" class="form-label">Add description:</label>
                    <textarea class="form-control textarea" id="exampleFormControlTextarea2" rows="5" name="description"
                        placeholder="add some description" required></textarea>
                    <div class="invalid-feedback">
                        Please add some description</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput3" class="form-label">Add Price:</label>
                    <input type="number" class="form-control" id="exampleFormControlInput3" name="price"
                        placeholder="Enter the price" required>
                    <div class="invalid-feedback">
                        vaild price in number.</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput4" class="form-label">Location name:</label>
                    <input type="text" class="form-control" id="exampleFormControlInput4" name="location"
                        placeholder="Enter the location" required>
                    <div class="invalid-feedback">
                        correct location name.</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput5" class="form-label">Country name:</label>
                    <input type="text" class="form-control" id="exampleFormControlInput5" name="country"
                        placeholder="enter country name" required>
                    <div class="invalid-feedback">
                        Enter the country name.</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>

                <div class="mb-3">
                    <label for="exampleFormControlInput6" class="form-label">image upload</label>
                    <input type="file" class="form-control" id="exampleFormControlInput6" name="image" required>
                    <div class="invalid-feedback">
                        Enter the country name.</div>
                    <div class="valid-feedback">
                        Looks good!</div>
                </div>
                <button class="add-btn">add</button>

            </form>
        </div>
        <!-- validation apply with the help of bootstrap -->
        <script src="/js/validationForm.js"></script>
    </body>